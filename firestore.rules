rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'lws5737@seoul-dongsan.es.kr';
    }

    match /artifacts/running-measurement-app/sharedRooms/dongsan-school-db {
      allow read, write: if isAllowedTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

